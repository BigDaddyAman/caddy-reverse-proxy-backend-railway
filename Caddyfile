{
    admin off
}

:{$PORT:8080} {

    log {
        output stdout
        format console
    }

    # ================================
    # BLOCK BAD USER AGENTS
    # ================================
    @bad_ua {
        header_regexp User-Agent (?i)(curl|wget|python|scrapy|scan|go-http-client|libwww-perl|java|php|perl|ruby)
    }

    handle @bad_ua {
        respond 403
    }

    # ================================
    # BLOCK SCANNER PATHS
    # ================================
    @bad_path {
        path_regexp (?i)^/(\.|xmlrpc\.php|wp-|phpmyadmin|wlwmanifest\.xml|aws|docker|backup|dump|config|git|svn)
    }

    handle @bad_path {
        respond 403
    }

    # ================================
    # STATIC ROOT
    # ================================
    root * /app/caddy/site

    # ================================
    # DJANGO API
    # ================================
    @django_api {
        path /health* /api/* /report*
    }

    reverse_proxy @django_api {$BACKEND_HOST}:{$BACKEND_PORT}

    # ================================
    # STATIC FILES
    # ================================
    @static {
        file
    }

    handle @static {
        file_server
    }

    # ================================
    # FALLBACK → DJANGO (SHORTLINKS)
    # ================================
    handle {
        reverse_proxy {$BACKEND_HOST}:{$BACKEND_PORT}
    }

    # ================================
    # SECURITY HEADERS
    # ================================
    header {
        X-Caddy "active"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin"
    }
}